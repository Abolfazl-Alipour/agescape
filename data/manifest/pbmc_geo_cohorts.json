    "pubmed_ids": ["37845489", "40046667"],
    "geo_public_date": "2023-08-31",
    "geo_last_update": "2025-03-20",
    "assay": "Confirmatory modified 10x Chromium 3' scRNA-seq with cell hashing; eight donors pooled per library plus a common control; NovaSeq; Cell Ranger; Ensembl GRCh38-3.0.0. Per-donor labeled H5 files are demultiplexed public objects.",
    "health_design": "Use healthy confirmatory scRNA PBMC donors. Exclude pediatric donors despite numeric age <=40, all TEA-seq discovery samples, IMM19 technical controls, stimulated/fixed RNA arms and pooled/unknown-age controls. Exclude ages 41-60 from the strict group contrast; CMV positivity is retained and modeled, not treated as disease exclusion.",
    "sex_restriction": "The TEA-seq discovery arm is female-only (8 pediatric and 8 older adults) and is excluded. The selected confirmatory scRNA arm is mixed sex: strict 13 female/10 male; published atlas 13 female/12 male.",
